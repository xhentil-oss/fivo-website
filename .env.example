# Copy to .env and fill in. Server-side vars (DB, JWT) are NEVER shipped to the
# browser. Only VITE_-prefixed vars reach the client — never put secrets there.

# ── MariaDB ───────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=fivo
DB_PASSWORD=change-me
DB_NAME=fivo
# DB_POOL=10
# CONTENT_TTL_MS=30000   # server content cache TTL (ms)

# ── Admin auth ──────────────────────────────────────────────────────────────
# Used by db/seed.mjs to create the first admin user, and to sign JWTs.
JWT_SECRET=generate-a-long-random-string
# JWT_EXPIRES=12h
ADMIN_USERNAME=admin
ADMIN_PASSWORD=set-a-strong-password

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5173
# NODE_ENV=production   # set in your process manager / systemd unit

# ── Client (optional) ─────────────────────────────────────────────────────────
# Contact form posts to /api/contact by default; override to use Formspree etc.
# VITE_CONTACT_ENDPOINT=https://formspree.io/f/your-id
# API base if the API is on a different origin than the app (usually not needed).
# VITE_API_BASE=/api
